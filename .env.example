# ---- Server ----
NODE_ENV=development
PORT=3000
# Origin of the frontend (CORS). In production the server serves the client itself.
CLIENT_URL=http://localhost:5173
LOG_LEVEL=info

# ---- Database ----
# sqlite -> one SQLite file (the only driver for now; see server/src/db/index.ts to add another)
DB_DRIVER=sqlite
# Relative paths resolve from server/ (the server's working dir), i.e. the repo-root data/ folder
SQLITE_PATH=../data/stock.db
# The old JSON database: imported once into an empty SQLite database, then renamed db.json.imported
JSON_DB_PATH=../data/db.json
# Daily JSON copies of the data are kept next to the database in backups/ (0 = off)
BACKUP_DAYS=30

# ---- Login ----
# 4-digit PINs set on the first start only (change them later in the app). They must differ.
# Unset: admin 1234, worker 0000 (a warning is logged).
# ADMIN_PIN=
# WORKER_PIN=

# Served over HTTPS? Controls HSTS / upgrade-insecure-requests. Defaults to false;
# set true once a TLS reverse proxy is in front of the app.
# HTTPS_ONLY=false

# ---- Docker compose only ----
# APP_PORT=3000
# 127.0.0.1 = reachable only through a reverse proxy on the same host
# APP_BIND=0.0.0.0
