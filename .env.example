# ---- Server ----
NODE_ENV=development
PORT=3000
# Origin of the frontend (CORS). In production the server serves the client itself.
CLIENT_URL=http://localhost:5173
LOG_LEVEL=info

# ---- Database ----
# json -> single JSON file (the only driver for now; see server/src/db/index.ts to add another)
DB_DRIVER=json
# Relative paths resolve from server/ (the server's working dir), i.e. the repo-root data/ folder
JSON_DB_PATH=../data/db.json
# Daily copies of the database file are kept next to it in backups/ (0 = off)
BACKUP_DAYS=30

# Served over HTTPS? Controls HSTS / upgrade-insecure-requests. Defaults to false;
# set true once a TLS reverse proxy is in front of the app.
# HTTPS_ONLY=false

# ---- Docker compose only ----
# APP_PORT=3000
